{
  "name": "Flow",
  "id": "studio.r4.flow",
  "version": "1.0.0",
  "build": 1,
  "icon": "assets/icon.png",
  "theme": "theme.json",
  "rust": "native",
  "window": {
    "defaultPosition": "center",
    "titleBar": {
      "style": "hidden",
      "height": 32
    }
  },
  "capabilities": {
    "application": true,
    "network": {
      "hosts": []
    },
    "process": {
      "env": ["FLOW_DB_PATH", "FLOW_FPS"]
    },
    "windows": {
      "levels": ["floating"]
    },
    "picker": true
  }
}
