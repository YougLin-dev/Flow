{
  "name": "Flow",
  "id": "studio.r4.flow",
  "version": "1.0.0",
  "build": 1,
  "icon": {
    "macos": "assets/icon-macos.png",
    "windows": "assets/icon.png",
    "linux": "assets/icon.png"
  },
  "theme": "theme.json",
  "rust": "native",
  "window": {
    "defaultPosition": "center",
    "titleBar": {
      "style": "hidden",
      "height": 32
    }
  },
  "capabilities": {
    "application": true,
    "network": {
      "hosts": []
    },
    "process": {
      "env": ["FLOW_DB_PATH", "FLOW_PROJECTS_ROOT", "FLOW_FPS"]
    },
    "windows": {
      "levels": ["floating"]
    },
    "picker": true
  },
  "toolchain": {
    "nsh": {
      "version": "rev=c24505c146c8b7966d780c65879b5822d09beac5",
      "repository": "YougLin-dev/nsh"
    }
  }
}
